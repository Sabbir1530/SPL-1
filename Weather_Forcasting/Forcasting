#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <time.h>
#include "Coefficient.h"

// Define the global normalization statistics for temperature model
NormStats temp_norm_stats = {0, 1, 0, 1, 0, 1};

typedef struct
{
    char Date[20];
    char Season[10];
    float Temperature;
    float Humidity;
    float Wind_Speed;
    float Pressure;
    int Rain;
} WeatherData;

int loadData(const char *filename, WeatherData **data, int *dataCount)
{
    FILE *file = fopen(filename, "r");  // Use the filename parameter, not hardcoded
    if (!file)
    {
        printf("Error opening file: %s\n", filename);
        return -1;
    }

    char line[400];
    int count = 0;

    while (fgets(line, sizeof(line), file))
    {
        count++;
    }
    rewind(file);

    *dataCount = count - 1;
    *data = (WeatherData *)malloc(*dataCount * sizeof(WeatherData));

    int index = 0;
    while (fgets(line, sizeof(line), file))
    {
        if (index == 0)
        {
            index++;
            continue;
        }

        char *token = strtok(line, ",");
        strcpy((*data)[index - 1].Date, token);

        token = strtok(NULL, ",");
        strcpy((*data)[index - 1].Season, token);

        token = strtok(NULL, ",");
        (*data)[index - 1].Temperature = atof(token);

        token = strtok(NULL, ",");
        (*data)[index - 1].Humidity = atof(token);

        token = strtok(NULL, ",");
        (*data)[index - 1].Wind_Speed = atof(token);

        token = strtok(NULL, ",");
        (*data)[index - 1].Pressure = atof(token);

        token = strtok(NULL, ",");
        (*data)[index - 1].Rain = (strcmp(token, "rain\n") == 0) ? 1 : 0; // (1 for rain, 0 for no rain)

        index++;
    }
    fclose(file);
    return 0;
}

void normalizeFeatures(float *data, int size)
{
    float min = data[0], max = data[0];
    for (int i = 1; i < size; i++)
    {
        if (data[i] < min)
            min = data[i];
        if (data[i] > max)
            max = data[i];
    }

    for (int i = 0; i < size; i++)
    {
        data[i] = (data[i] - min) / (max - min); // Normalize between 0 and 1
    }
}

// logistic regression for rain prediction - returns probability, not hardcoded 0/1
float predictRain(float humidity, float wind_speed, float pressure, double *coefficients)
{
    float dotProduct = coefficients[0] + 
                       coefficients[1] * humidity + 
                       coefficients[2] * wind_speed + 
                       coefficients[3] * pressure;

    float probability = 1.0f / (1.0f + expf(-dotProduct));
    return probability;  // Return actual probability for model evaluation
}

// Linear regression for temperature prediction with normalized features
float predictTemperature(float humidity, float wind_speed, float pressure, double *coefficients)
{
    // Feature normalization statistics (calculated from training data)
    // These values must match those used in finalCoefficientCalc()
    double norm_hum = (humidity - temp_norm_stats.hum_mean) / temp_norm_stats.hum_std;
    double norm_wind = (wind_speed - temp_norm_stats.wind_mean) / temp_norm_stats.wind_std;
    double norm_pres = (pressure - temp_norm_stats.pres_mean) / temp_norm_stats.pres_std;
    
    return coefficients[0] + 
           coefficients[1] * norm_hum + 
           coefficients[2] * norm_wind + 
           coefficients[3] * norm_pres;
}

// Shuffle data for random train/test split
void shuffleData(WeatherData *data, int size)
{
    for (int i = size - 1; i > 0; i--)
    {
        int j = rand() % (i + 1);
        WeatherData temp = data[i];
        data[i] = data[j];
        data[j] = temp;
    }
}

void splitDataset(WeatherData *data, int dataCount, WeatherData **trainSet, WeatherData **testSet, int *trainCount, int *testCount, float ratio)
{
    // Shuffle data for proper train/test split
    shuffleData(data, dataCount);
    
    *trainCount = (int)(dataCount * ratio);
    *testCount = dataCount - *trainCount;

    *trainSet = (WeatherData *)malloc(*trainCount * sizeof(WeatherData));
    *testSet = (WeatherData *)malloc(*testCount * sizeof(WeatherData));

    for (int i = 0; i < *trainCount; i++)
    {
        (*trainSet)[i] = data[i];
    }

    for (int i = *trainCount; i < dataCount; i++)
    {
        (*testSet)[i - *trainCount] = data[i];
    }
}

// Evaluate rain prediction accuracy
void evaluateRainModel(WeatherData *testSet, int testCount, double *coefficients)
{
    int truePositive = 0, trueNegative = 0, falsePositive = 0, falseNegative = 0;
    float RAIN_THRESHOLD = 0.65f;  // Threshold optimized for balanced predictions

    for (int i = 0; i < testCount; i++)
    {
        float probability = predictRain(testSet[i].Humidity, testSet[i].Wind_Speed, testSet[i].Pressure, coefficients);
        int prediction = (probability > RAIN_THRESHOLD) ? 1 : 0;
        int actual = testSet[i].Rain;

        if (prediction == 1 && actual == 1) truePositive++;
        else if (prediction == 0 && actual == 0) trueNegative++;
        else if (prediction == 1 && actual == 0) falsePositive++;
        else if (prediction == 0 && actual == 1) falseNegative++;
    }

    float accuracy = ((float)(truePositive + trueNegative) / testCount) * 100;
    float precision = (truePositive + falsePositive > 0) ? ((float)truePositive / (truePositive + falsePositive)) * 100 : 0;
    float recall = (truePositive + falseNegative > 0) ? ((float)truePositive / (truePositive + falseNegative)) * 100 : 0;

    printf("\n========== RAIN PREDICTION ACCURACY ==========\n");
    printf("Accuracy:  %.2f%%\n", accuracy);
    printf("Precision: %.2f%%\n", precision);
    printf("Recall:    %.2f%%\n", recall);
    printf("Confusion Matrix: TP=%d, TN=%d, FP=%d, FN=%d\n", truePositive, trueNegative, falsePositive, falseNegative);
    printf("============================================\n");
}

// Evaluate temperature prediction accuracy
void evaluateTemperatureModel(WeatherData *testSet, int testCount, double *coefficients)
{
    float sumError = 0, sumSquaredError = 0;
    int withinRange5 = 0, withinRange10 = 0;

    for (int i = 0; i < testCount; i++)
    {
        float prediction = predictTemperature(testSet[i].Humidity, testSet[i].Wind_Speed, testSet[i].Pressure, coefficients);
        float error = fabs(prediction - testSet[i].Temperature);

        sumError += error;
        sumSquaredError += error * error;

        if (error <= 5.0f) withinRange5++;
        if (error <= 10.0f) withinRange10++;
    }

    float mae = sumError / testCount;
    float rmse = sqrtf(sumSquaredError / testCount);
    float accuracy5 = (withinRange5 / (float)testCount) * 100;
    float accuracy10 = (withinRange10 / (float)testCount) * 100;

    printf("\n========== TEMPERATURE PREDICTION ACCURACY ==========\n");
    printf("Mean Absolute Error (MAE):     %.2f°C\n", mae);
    printf("Root Mean Squared Error (RMSE): %.2f°C\n", rmse);
    printf("Accuracy (within 5°C):         %.2f%%\n", accuracy5);
    printf("Accuracy (within 10°C):        %.2f%%\n", accuracy10);
    printf("====================================================\n");
}

// Find temperature and season for a given date
void previousData(const char *date, WeatherData *data, int dataCount)
{
    for (int i = 0; i < dataCount; i++)
    {
        if (strcmp(data[i].Date, date) == 0)
        {
            printf("Date: %s\n", data[i].Date);
            printf("Temperature: %.2f\n", data[i].Temperature);
            printf("Season: %s\n", data[i].Season);
            return;
        }
    }
    printf("Date not found in dataset.\n");
}

