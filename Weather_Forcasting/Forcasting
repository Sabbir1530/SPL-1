{
    WeatherData *data;
    int dataCount;

    if (loadData("Processed_Datase.csv", &data, &dataCount) != 0)
    {
        return -1;
    }

    printf("Dataset loaded with %d records.\n", dataCount);

    // Split
    WeatherData *trainSet, *testSet;
    int trainCount, testCount;
    splitDataset(data, dataCount, &trainSet, &testSet, &trainCount, &testCount, 0.8);

    printf("Training data count: %d, Testing data count: %d\n", trainCount, testCount);

    // Calculate temperature prediction coefficients
    double *tempCoefficients = finalCoefficientCalc();
    printf("\n========== TEMPERATURE MODEL COEFFICIENTS ==========\n");
    printf("Intercept:     %.6f\n", tempCoefficients[0]);
    printf("Humidity:      %.6f\n", tempCoefficients[1]);
    printf("Wind Speed:    %.6f\n", tempCoefficients[2]);
    printf("Pressure:      %.6f\n", tempCoefficients[3]);
    printf("==================================================\n");

    // Calculate rain prediction coefficients (separate model)
    double *rainCoefficients = trainRainModel();
    printf("\n========== RAIN MODEL COEFFICIENTS ==========\n");
    printf("Intercept:     %.6f\n", rainCoefficients[0]);
    printf("Humidity:      %.6f\n", rainCoefficients[1]);
    printf("Wind Speed:    %.6f\n", rainCoefficients[2]);
    printf("Pressure:      %.6f\n", rainCoefficients[3]);
    printf("==========================================\n\n");

    // Evaluate rain prediction model (with separate rain coefficients)
    evaluateRainModel(testSet, testCount, rainCoefficients);
    
    // Evaluate temperature prediction model (with temperature coefficients)
    evaluateTemperatureModel(testSet, testCount, tempCoefficients);

    // Predict temperature for a given condition
    srand(time(NULL));
    float humidity = 50.0 + (rand() % 51);
    float wind_speed = 5.0 + (rand() % 11);   
    float pressure = 990.0 + (rand() % 61); 

    printf("\n");

    printf("Input Condition:\n");
    printf("Humidity: %.2f\n", humidity);
    printf("Wind Speed: %.2f\n", wind_speed);
    printf("Pressure: %.2f\n", pressure);  
    printf("\n");

    float rainProbability = predictRain(humidity, wind_speed, pressure, rainCoefficients);
    int rainPrediction = (rainProbability > 0.5f) ? 1 : 0;
    printf("Rain Probability: %.2f%%\n", rainProbability * 100);
    printf("Prediction: %s\n", rainPrediction == 1 ? "Rain" : "No Rain");

    float predictedTemp = predictTemperature(humidity, wind_speed, pressure, tempCoefficients);
    printf("Predicted Temperature: %.2f°C\n", predictedTemp);

    printf("\n");

    char inputDate[20];
    printf("Enter a date (MM/DD/YYYY): ");
    scanf("%19s", inputDate);
    previousData(inputDate, data, dataCount);

    free(data);
    free(trainSet);
    free(testSet);
    free(tempCoefficients);
    free(rainCoefficients);

    return 0;
}
